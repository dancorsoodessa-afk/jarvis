# Gemini cloud voice configuration (copy values into the app's environment/config)
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Charon
GEMINI_TTS_LANGUAGE=ru-RU
# Optional: JARVIS_STT=local to force installed faster-whisper; auto fallback uses it only if installed.
# JARVIS_STT=gemini
# JARVIS_TTS=gemini

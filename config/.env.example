# Gemini cloud voice configuration (copy values into the app's environment/config)
GEMINI_API_KEY=
# Optional independent cloud STT fallback; used only after Gemini quota exhaustion.
GROQ_API_KEY=
JARVIS_STT_FALLBACK_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TOOLS_ENABLED=false
GEMINI_STT_ENABLED=true
VOICE_DEGRADE_ON_429=true
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
TTS_LANGUAGE=ru-RU
TTS_VOICE=Charon
GEMINI_TTS_VOICE=Charon
GEMINI_TTS_LANGUAGE=ru-RU
# Optional: JARVIS_STT=local to force installed faster-whisper.
# JARVIS_STT=gemini
# JARVIS_TTS=gemini

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY agent ./agent
COPY crypto_analyst ./crypto_analyst
COPY strategic ./strategic
COPY storage ./storage

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir ".[crypto-infra]"

RUN useradd --create-home --uid 10001 jarvis
USER jarvis

CMD ["python", "-m", "crypto_analyst.worker"]
